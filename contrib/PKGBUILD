# Maintainer: Pedro Amaral Couto
#
# Builds pachud from the checkout this file lives in (contrib/PKGBUILD), including
# uncommitted changes, so it works before there is a release to download:
#
#     cd contrib && makepkg -si
#
pkgname=pachud-git
pkgver=0.1.0.r2.d77b303
pkgrel=1
pkgdesc='Event-driven HUDs and notification daemon for Wayland'
arch=(x86_64 aarch64)
license=(MIT)
depends=(wayland cairo systemd-libs freetype2 harfbuzz fribidi)
makedepends=(wayland-protocols pkgconf gettext git)
optdepends=(
    'pipewire-pulse: volume and microphone HUDs (any PulseAudio-compatible server works)'
    'noto-fonts: Latin, Cyrillic and Indic/Thai text'
    'noto-fonts-cjk: Chinese, Japanese and Korean text'
    'ttf-dejavu: Arabic and Hebrew text'
    'libpulse: paplay, for alarm sounds (pw-play from pipewire also works)'
)
provides=(pachud notification-daemon)
conflicts=(pachud)

_root() { cd "$startdir/.." && pwd; }

pkgver() {
    cd "$(_root)"
    local count commit
    if count=$(git rev-list --count HEAD 2>/dev/null) && commit=$(git rev-parse --short HEAD 2>/dev/null); then
        printf '0.1.0.r%s.%s' "$count" "$commit"
    else
        printf '0.1.0'
    fi
}

prepare() {
    # Copy the tree (tracked and untracked files, minus what .gitignore excludes) so the
    # build never writes into the checkout.
    mkdir -p "$srcdir/$pkgname"
    cd "$(_root)"
    git ls-files -z --cached --others --exclude-standard | tar --null -T - -cf - |
        tar -xf - -C "$srcdir/$pkgname"
}

build() {
    cd "$srcdir/$pkgname"
    make PREFIX=/usr
}

check() {
    cd "$srcdir/$pkgname"
    make PREFIX=/usr test
}

package() {
    cd "$srcdir/$pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
