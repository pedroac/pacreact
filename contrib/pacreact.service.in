[Unit]
Description=pacreact: HUDs and notifications
PartOf=graphical-session.target
After=graphical-session.target pacreactd.socket
Wants=pacreactd.socket
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=@BINDIR@/pacreact
Restart=on-failure
# The notification history lives in memory: no core dumps, and no gaining privileges.
LimitCORE=0
NoNewPrivileges=yes
RestartSec=2

[Install]
WantedBy=graphical-session.target
